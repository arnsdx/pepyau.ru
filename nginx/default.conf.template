limit_req_zone $binary_remote_addr zone=per_ip_requests:10m rate=5r/s;
limit_req_zone $server_name zone=all_requests:1m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=per_ip_connections:10m;
limit_conn_zone $server_name zone=all_connections:1m;

map $scheme $http_redirect_host {
    default "";
    http "${HTTP_REDIRECT_HOST}";
}

server {
    listen 80 default_server;
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    server_tokens off;

    include /etc/nginx/tls/current.conf;
    ssl_protocols TLSv1.2 TLSv1.3;

    if ($http_redirect_host != "") {
        return 308 https://$http_redirect_host$request_uri;
    }

    limit_req zone=per_ip_requests burst=15 nodelay;
    limit_req zone=all_requests burst=50 nodelay;
    limit_conn per_ip_connections 8;
    limit_conn all_connections 64;
    limit_req_status 429;
    limit_conn_status 429;

    client_max_body_size 16k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 15s;

    # Resolve the Compose service again when its container is replaced.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 3s;

    location / {
        set $backend app:8000;
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 15s;
        proxy_intercept_errors off;
    }
}
